<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="hikashoppayment" method="upgrade">
    <name>Hikashop Encaisse payment plugin</name>
    <author>TelEtCom</author>
    <creationDate>2026</creationDate>
    <copyright>TelEtCom</copyright>
    <version>1.0.0</version>
    <description>Plugin de paiement Encaisse pour HikaShop</description>

    <files>
        <filename plugin="encaisse">encaisse.php</filename>
        <folder>helpers</folder>
        <folder>assets</folder>
        <folder>language</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/en-GB.plg_hikashoppayment_encaisse.ini</language>
        <language tag="fr-FR">language/fr-FR/fr-FR.plg_hikashoppayment_encaisse.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic" label="Configuration Encaisse">

                <field name="client_id" type="text" label="Client ID" required="true" />

                <field name="client_secret" type="password" label="Client Secret" required="true" />

                <field name="company_id" type="text" label="Company ID" required="true" />

            </fieldset>
        </fields>
    </config>
</extension>